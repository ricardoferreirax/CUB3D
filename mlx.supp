{
   mlx_x11_leaks
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   obj:/usr/lib*/libX11.so*
}
{
   mlx_xext_leaks
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   obj:/usr/lib*/libXext.so*
}
{
   mlx_mlx_leaks
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   obj:*/libmlx*
}
{
   mlx_xcb_leaks
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   obj:/usr/lib*/libxcb.so*
}
{
   x11_xcb_writev_uninitialised
   Memcheck:Param
   writev(vector[0])
   ...
   fun:writev
   ...
   fun:xcb_writev
   ...
   fun:mlx_new_window
}
{
   glibc_loader_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   obj:*/ld-linux-*
}